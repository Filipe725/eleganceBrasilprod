# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave service_role (Project Settings > API > service_role). NUNCA prefixar
# com NEXT_PUBLIC_ — só é lida em Server Actions, nunca chega ao navegador.
# Necessária para a aba "Admins" do painel (convidar/remover administradores).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL pública do site, sem barra no final. Usada no link de convite de
# admin, no sitemap/robots e nas prévias de compartilhamento (Open Graph).
# Sem ela, o site usa o cabeçalho Host da requisição (menos seguro).
NEXT_PUBLIC_SITE_URL=https://elegancebrasil.com.br

# ID do Meta Pixel (opcional; sem ela, usa o ID atual da loja)
NEXT_PUBLIC_META_PIXEL_ID=1098667079338567

# Número do WhatsApp que receberá os pedidos, com DDD e sem símbolos.
# Ex.: 11 99999-8888  ->  5511999998888
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999998888

# Nome da loja (aparece no cabeçalho e na mensagem do pedido)
NEXT_PUBLIC_STORE_NAME=ÉléganceBrasil

# Contatos institucionais (footer e página Fale Conosco)
NEXT_PUBLIC_STORE_EMAIL=contato@elegancebrasil.com.br
NEXT_PUBLIC_STORE_ADDRESS=Av. Paulista, 1000 — São Paulo/SP
