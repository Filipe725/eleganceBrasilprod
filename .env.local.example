# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Número do WhatsApp que receberá os pedidos, com DDD e sem símbolos.
# Ex.: 11 99999-8888  ->  5511999998888
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999998888

# Nome da loja (aparece no cabeçalho e na mensagem do pedido)
NEXT_PUBLIC_STORE_NAME=ÉléganceBrasil

# Contatos institucionais (footer e página Fale Conosco)
NEXT_PUBLIC_STORE_EMAIL=contato@elegancebrasil.com.br
NEXT_PUBLIC_STORE_ADDRESS=Av. Paulista, 1000 — São Paulo/SP
